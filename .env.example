# Copy this file to ".env.local" to change how the site runs on your computer.
# Without it the site still works: data is kept in memory and resets when you stop the server.

# Use a real MongoDB database, so orders and stock survive a restart:
# MONGODB_URI=mongodb://localhost:27017/localrush

# Signs the login cookie. Any long random text.
# SESSION_SECRET=change-me-to-a-long-random-string

# Google's real 3D map of your location, with the real shops near you. Needs "Maps JavaScript
# API" and "Places API (New)" switched on for the key (see README, "Real 3D map").
# Without it the home page shows LocalRush's own 3D scene. Restart "npm run dev" after changing it.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-key-here

# ---------- The live service (see README, "Going live") ----------
# "demo" (the default for npm run dev): sample shops, any 4-digit code logs in.
# "live" (the default for a production build): login with Google or email, no sample data, admins add shops.
# LOCALRUSH_MODE=demo

# Login with Google or email, through Firebase (free plan). From Firebase: Project settings > General > Your apps > Web app.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-web-api-key
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com   (optional; this is the default)

# Emails that may use /admin to add shops and delivery partners, comma separated.
# ADMIN_EMAILS=you@gmail.com

# Shown on the terms and privacy page as the way to contact you (an email or phone number).
# SUPPORT_CONTACT=help@example.com
